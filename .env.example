# Copy only the variables needed by your chosen local workflow. Never commit .env.
# production-site/tools/handover-local.mjs: required, local-only >=12 characters.
HANDOVER_ADMIN_PASSWORD=
# Optional loopback port; default 18787.
HANDOVER_PORT=18787
# Separate local PostgreSQL apps only; set in each backend/.env, not production.
# Use a newly created handover_* database on ports 15432/15433.
DATABASE_URL=postgresql://handover:SET_LOCAL_PASSWORD@127.0.0.1:15433/handover_roster
PORT=14020
NODE_ENV=development
CORS_ORIGIN=http://127.0.0.1:5176,http://127.0.0.1:5174
EVALUATE_API_BASE_URL=http://127.0.0.1:14000/api
EVALUATE_APP_ORIGIN=http://127.0.0.1:5174
APP_ORIGIN=
AUTH_SESSION_DAYS=7
VITE_API_BASE_URL=http://127.0.0.1:14020/api
MULTI_AGENT_ENGINE_URL=http://127.0.0.1:14191
# Optional external integrations; disabled until deliberately configured server-side.
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_TOKEN_KEY=
XERO_REDIRECT_URI=http://localhost:18787/api/payroll/oauth/callback
XERO_ENABLE_TRACKING=0
AI_ANALYSIS_PROVIDER=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
AI_ANALYSIS_TIMEOUT_MS=15000
MULTI_AGENT_API_KEY=
MULTI_AGENT_MODEL=
MULTI_AGENT_BASE_URL=https://api.anthropic.com
ROSTER_DATABASE_READONLY_URL=
ADMIN_USERNAME=
ADMIN_DISPLAY_NAME=
ADMIN_INITIAL_PASSWORD=
