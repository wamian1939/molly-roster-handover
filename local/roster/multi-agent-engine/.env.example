# Anthropic Messages-compatible endpoint. Existing ANTHROPIC_* variables are supported.
MULTI_AGENT_MODEL=
MULTI_AGENT_API_KEY=
MULTI_AGENT_BASE_URL=https://api.anthropic.com
MULTI_AGENT_TIMEOUT_SECONDS=180
# Optional per-agent models: MULTI_AGENT_REQUIREMENT_MODEL, DAILY_MODEL, REVIEW_MODEL, AUDIT_MODEL
# Set actual provider rates. Unconfigured costs are UNKNOWN, never reported as free.
MULTI_AGENT_INPUT_USD_PER_MILLION=
MULTI_AGENT_OUTPUT_USD_PER_MILLION=
