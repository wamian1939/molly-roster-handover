# Vite uses the same-origin /api proxy in development and production.
# Set only when a non-standard API topology is required.
VITE_API_BASE_URL=

# Development uses employee-demo; account mode requires the documented employee backend.
# Production employee route is enabled only after explicitly selecting account mode.
VITE_EMPLOYEE_PORTAL_MODE=
# Optional same-origin login path supplied by the future employee account system.
VITE_EMPLOYEE_SIGN_IN_PATH=

