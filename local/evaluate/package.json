{
  "name": "evaluate-molly",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19 <23"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5174",
    "dev:all": "powershell -ExecutionPolicy Bypass -File scripts/start-dev.ps1",
    "dev:all:setup": "powershell -ExecutionPolicy Bypass -File scripts/start-dev.ps1 -Install -Migrate",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "render:build": "npm run build && npm --prefix backend run build",
    "render:start": "npm --prefix backend run start",
    "preview": "vite preview --host 127.0.0.1 --port 4174"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@radix-ui/react-select": "^2.3.7",
    "@vitejs/plugin-react": "^5.1.1",
    "framer-motion": "^12.23.26",
    "gsap": "^3.15.0",
    "lucide-react": "^0.561.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.5.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.2",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.22",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.23",
    "tailwindcss": "^3.4.18",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.49.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.8"
  }
}
