NODE_ENV=development
DATABASE_URL="postgresql://USER:PASSWORD@127.0.0.1:5432/evaluate_molly"
PORT=4000
CORS_ORIGIN="http://127.0.0.1:5174,http://localhost:5174"
# Required for production outside Render. On Render, RENDER_EXTERNAL_HOSTNAME is used automatically.
# When set, use the exact public origin with no path or trailing slash.
APP_ORIGIN=
AUTH_SESSION_DAYS=7

# Supabase production format for this persistent Render service:
# postgresql://prisma.PROJECT_REF:PASSWORD@aws-REGION.pooler.supabase.com:5432/postgres?sslmode=require

# Set only while running `npm run auth:bootstrap-admin`, then remove the password.
ADMIN_USERNAME=
ADMIN_DISPLAY_NAME=
ADMIN_INITIAL_PASSWORD=
